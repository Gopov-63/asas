@model IEnumerable<ShoppingList.Models.Products.ProductListVM>


@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">Products</h1>
<hr />

<div class="d-grid gap-2 mb-3">
    <a asp-controller="Products" asp-action="Create" class="btn btn-primary">Create Product</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-sm-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title text-center">@product.ProductName</h4>

                        <div class="d-grid gap-2">
                            <a asp-controller="Products" 
                               asp-action="Edit" 
                               asp-route-id="@product.Id" 
                               class="btn btn-warning">
                                Edit
                            </a>

                            <form asp-controller="Products" 
                                  asp-action="Delete" 
                                  asp-route-id="@product.Id" 
                                  method="post" 
                                  class="mt-2">
                                @Html.AntiForgeryToken()
                                <div class="d-grid gap-2">
                                    <input type="submit" value="Delete" class="btn btn-danger" />
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-center">No products yet!</p>
}